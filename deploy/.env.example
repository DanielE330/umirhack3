# Ключ Fernet центра: docker compose run --rm center python -m app.cli gen-key
HF_SECRET_KEY=
HF_DB_PASSWORD=
# Межсервисный токен центр -> оркестратор: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ORCH_TOKEN=
# false — только пока вход по http без TLS
HF_COOKIE_SECURE=false
# Адрес центра, по которому до него достают агенты из DMZ
HF_PUBLIC_URL=http://192.168.1.122:4000

# Proxmox: лучше API-токен (PROXMOX_USER=honeyforge@pve!..), иначе пароль
PROXMOX_HOST=192.168.1.94
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=
PROXMOX_TOKEN_NAME=
PROXMOX_TOKEN_VALUE=
