# Ключ Fernet: docker compose run --rm center python -m app.cli gen-key
HF_SECRET_KEY=
HF_DB_PASSWORD=
# false — только пока центр открыт по http без TLS
HF_COOKIE_SECURE=false
HF_PUBLIC_URL=http://127.0.0.1:4000
# Папка веб-интерфейса; по умолчанию находится сама (frontend/ в корне репозитория)
# HF_STATIC_DIR=
